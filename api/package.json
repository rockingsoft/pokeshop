{
  "name": "PokeshopAPI",
  "version": "1.0.0",
  "description": "A zero-code instrumentation test subject for Lamplight",
  "main": "handler.js",
  "scripts": {
    "test": "npm run build",
    "start": "nodemon --watch 'src/**' --exec 'ts-node -r tsconfig-paths/register ./src/api.ts'",
    "start:worker": "nodemon --watch 'src/**' --exec 'ts-node -r tsconfig-paths/register ./src/worker.ts'",
    "start:stream-worker": "nodemon --watch 'src/**' --exec 'ts-node -r tsconfig-paths/register ./src/streamWorker.ts'",
    "start:rpc": "nodemon --watch 'src/**' --exec 'ts-node -r tsconfig-paths/register ./src/rpc.ts'",
    "build": "tsc --project tsconfig.json && tspath -f",
    "api": "node api.js",
    "rpc": "node rpc.js",
    "worker": "node worker.js",
    "stream-worker": "node streamWorker.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/amqplib": "^0.8.2",
    "@types/debug": "^4.1.8",
    "@types/koa": "^2.13.6",
    "@types/lodash": "^4.14.195",
    "@types/node": "^17.0.24",
    "@types/validator": "^13.7.17",
    "node-ts": "^5.1.2",
    "nodemon": "^1.3.3",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^3.14.2",
    "tspath": "^1.2.10",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@koa/cors": "^3.3.0",
    "@koa/router": "^10.1.1",
    "@types/node-fetch": "^2.6.4",
    "amqplib": "^0.8.0",
    "class-transformer": "^0.5.1",
    "class-transformer-validator": "^0.9.1",
    "class-validator": "^0.13.2",
    "debug": "^4.3.4",
    "dotenv": "^16.1.4",
    "file-type": "^16.5.3",
    "ioredis": "^4.28.5",
    "kafkajs": "^2.2.4",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.4.0",
    "koa-logger": "^3.2.1",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.11",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.32.0",
    "sequelize-typescript": "^2.1.3",
    "umzug": "^3.1.1"
  }
}
