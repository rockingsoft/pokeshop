test "Import a Pokemon reading a Stream" {
  tags = ["kafka", "zero-code"]

  step "request" {
    kafka_request {
      broker_urls   = [var.KAFKA_BROKER_URL]
      topic         = "pokemon"
      message_value = jsonencode({ id = 143 })
      message_key   = "snorlax-key"
    }

    check "Kafka accepts the Pokemon event" {
      response = {
        "partition is returned" = response.json.partition >= 0
        "offset is returned"    = response.json.offset >= 0
      }
    }
  }
}
