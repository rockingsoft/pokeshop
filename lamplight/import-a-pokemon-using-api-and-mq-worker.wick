test "Import a Pokemon using API and MQ Worker" {
  tags = ["api", "messaging", "zero-code"]

  step "request" {
    http_request {
      method = "POST"
      url    = "${var.POKESHOP_API_URL}/pokemon/import"
      headers = {
        "Content-Type" = "application/json"
      }
      body = jsonencode({ id = 143, ignoreCache = true })
    }

    check "Pokemon import is accepted" {
      response = {
        "status code is 200" = response.status_code == 200
      }
    }
  }
}
