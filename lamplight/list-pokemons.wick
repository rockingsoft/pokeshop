test "List Pokemons" {
  tags = ["api", "zero-code"]

  step "request" {
    http_request {
      method = "GET"
      url    = "${var.POKESHOP_API_URL}/pokemon?take=20&skip=0"
      headers = {
        "Content-Type" = "application/json"
      }
    }

    check "Pokemon list is returned" {
      response = {
        "status code is 200"   = response.status_code == 200
        "total count is valid" = response.json.totalCount >= 0
      }
    }

    check "API emits an HTTP server span" {
      spans {
        matching = span.attributes["http.request.method"] == "GET"
        at_least = 1
      }
    }
  }
}
