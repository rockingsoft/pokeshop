test "Pokeshop - Add" {
  tags = ["api", "zero-code"]

  step "request" {
    http_request {
      method = "POST"
      url    = "${var.POKESHOP_API_URL}/pokemon"
      headers = {
        "Content-Type" = "application/json"
      }
      body = jsonencode({
        name       = "meowth"
        type       = "normal"
        imageUrl   = var.MEOWTH_IMAGE_URL
        isFeatured = false
      })
    }

    check "Pokemon is created" {
      response = {
        "status code is 201" = response.status_code == 201
      }
    }

    check "API emits an HTTP server span" {
      spans {
        matching = span.attributes["http.request.method"] == "POST"
        at_least = 1
      }
    }
  }
}
