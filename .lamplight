project {
  base_dir       = "./lamplight"
  output         = "pretty"
  default_target = "compose"
}

variable "POKESHOP_API_URL" {
  default = "http://localhost:8081"
}

variable "KAFKA_BROKER_URL" {
  default = "localhost:29092"
}

variable "POKESHOP_GRPC_ADDRESS" {
  default = "localhost:8082"
}

variable "POKESHOP_WEB_URL" {
  default = "http://localhost:3000"
}

target "compose" {
  runtime = "docker_compose"

  docker_compose {
    project  = "pokeshop"
    services = ["api", "rpc", "web"]
  }

  variables = {
    POKESHOP_API_URL      = "http://api:8081"
    KAFKA_BROKER_URL      = "stream:9092"
    POKESHOP_GRPC_ADDRESS = "rpc:8082"
    POKESHOP_WEB_URL      = "http://web"
  }
}

target "k3s" {
  runtime = "kubernetes"

  kubernetes {
    context   = "k3d-pokeshop"
    namespace = "pokeshop"
  }

  variables = {
    POKESHOP_API_URL      = "http://api:8081"
    KAFKA_BROKER_URL      = "stream:9092"
    POKESHOP_GRPC_ADDRESS = "rpc:8082"
    POKESHOP_WEB_URL      = "http://web"
  }
}

datasource "otlp" {
  endpoint           = "http://127.0.0.1:4318"
  observation_window = duration("30s")
}

instrumentation "obi" {
  open_ports          = [80, 8081, 8082, 9092]
  context_propagation = "all"
}
